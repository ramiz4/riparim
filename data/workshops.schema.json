{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riparim workshop source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "updatedAt",
    "coverage",
    "googleImport",
    "workshops"
  ],
  "properties": {
    "$schema": {
      "const": "./workshops.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCode",
        "published",
        "drafts",
        "estimatedTotal",
        "estimateSource",
        "complete"
      ],
      "properties": {
        "countryCode": {
          "const": "XK"
        },
        "published": {
          "type": "integer",
          "minimum": 0
        },
        "drafts": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedTotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "estimateSource": {
          "const": "user"
        },
        "complete": {
          "const": false
        }
      }
    },
    "googleImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "matchedPlaceIds",
        "numericSnapshotRatings",
        "pendingPublishedMatches"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "partial",
            "completed"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchedPlaceIds": {
          "type": "integer",
          "minimum": 0
        },
        "numericSnapshotRatings": {
          "type": "integer",
          "minimum": 0
        },
        "pendingPublishedMatches": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workshops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workshop"
      }
    }
  },
  "$defs": {
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "maxLength": 250
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "phoneNote": {
          "type": "string",
          "maxLength": 150
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "specialty": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "brands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "minItems": 1
        },
        "serviceDetails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "minItems": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 41.8,
          "maximum": 43.3
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 19.8,
          "maximum": 21.9
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "title"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "official",
                  "directory"
                ]
              }
            }
          }
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "google": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placeId",
            "matchedAt",
            "snapshot"
          ],
          "properties": {
            "placeId": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9_-]{10,255}$"
            },
            "matchedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshot": {
              "anyOf": [
                {
                  "$ref": "#/$defs/googleSnapshot"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "name",
        "city",
        "address",
        "phone",
        "phoneNote",
        "whatsapp",
        "specialty",
        "description",
        "brands",
        "services",
        "serviceDetails",
        "languages",
        "lat",
        "lng",
        "sources",
        "checkedAt",
        "status",
        "updatedAt",
        "google"
      ]
    },
    "googleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "count",
        "mapsUrl",
        "sourceUrl",
        "sourceLabel",
        "checkedAt",
        "sourceUpdatedAt"
      ],
      "properties": {
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mapsUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "sourceUpdatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
