{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riparim",
  "account_id": "ec181b3a61c7c3da13910600953fc3ea",
  "main": "./build/cloudflare-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"html_handling": "none"},
  "workers_dev": true,
  "routes": [
    {"pattern": "riparim.com", "zone_id": "cb2470c7a7d49b8a3e6aa3e697c3355e", "custom_domain": true, "enabled": true, "previews_enabled": false},
    {"pattern": "www.riparim.com", "zone_id": "cb2470c7a7d49b8a3e6aa3e697c3355e", "custom_domain": true, "enabled": true, "previews_enabled": false}
  ],
  "triggers": {"crons": ["*/5 * * * *"]},
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://riparim.com"
  },
  "secrets": {
    "required": ["REVIEW_MODERATOR_EMAIL"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "riparim-production",
    "database_id": "b395ea3a-5316-4b0b-bdee-533bdb68d6a0",
    "migrations_dir": "drizzle",
    "remote": false
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "riparim-evidence-production",
    "remote": false
  }],
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  }
}
