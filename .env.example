REVIEW_MODERATOR_EMAIL=
SITE_ORIGIN=http://127.0.0.1:5174
# Optional public PostHog project configuration; no analytics without a key and consent.
# Cloudflare production uses release-bound public values in wrangler.jsonc.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Mark all isolated local events as verification; never enable in production.
POSTHOG_TEST_MODE=false
# Optional one-time activation of an existing auth_settings draft; later owner edits win.
EMAIL_LOGIN_ACTIVATION_PROJECT=
EMAIL_LOGIN_ACTIVATION_TIME=
# Optional exact HTTPS origin of a compatible self-hosted Auth instance. Server-only.
AUTH_TRUSTED_ORIGIN=
# Bind the administrative credential to its exact HTTPS origin; required for custom hosts.
SUPABASE_SECRET_KEY_ORIGIN=
# Server-only secret/service-role key issued by that same Auth instance.
SUPABASE_SECRET_KEY=

# Google Cloud APIs and restricted keys must be configured before activating live ratings.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=

# Server-only review mail. Unset EMAIL_TRANSPORT keeps Resend compatible.
EMAIL_TRANSPORT=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
# Node-only alternative; credentials must match the exact scheme/host/port origin.
SMTP_URL=
SMTP_SECRET_ORIGIN=

# Portable Node runtime: dedicated private directory, never inside public/.
RIPARIM_DATA_DIR=.riparim

# Optional explicit reverse-proxy peer IPs; that proxy must overwrite X-Real-IP.
RIPARIM_TRUSTED_PROXIES=
