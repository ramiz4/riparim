# Example only. Do not activate until the operator's separate acceptance.
BACKUP_MONITOR_ENABLED=false
BACKUP_MONITOR_PAUSED=true
BACKUP_MONITOR_STATE_PATH=/var/lib/riparim-backup-monitor/state.json
BACKUP_MONITOR_EMAIL_FROM=Riparim Backups <no-reply@auth.example.com>
BACKUP_MONITOR_EMAIL_TO=operator@example.com
BACKUP_MONITOR_RESEND_API_KEY=REPLACE_WITH_PRIVATE_FULL_ACCESS_KEY
BACKUP_MONITOR_HEARTBEAT_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# Optional: repository-scoped Actions Read only; public metadata also works without a token.
BACKUP_MONITOR_GITHUB_TOKEN=
